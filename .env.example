# GEMINI_API_KEY: Optional if AI capabilities are enabled. Not required for portal core.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server listening port (default: 3000)
PORT=3000

# AXIS_PORTAL_TIMEZONE: Local timezone for Nepal academic operations (default: Asia/Kathmandu)
AXIS_PORTAL_TIMEZONE="Asia/Kathmandu"

# GOOGLE_APPS_SCRIPT_URL: Web App URL from deployed Google Apps Script
# Used as the authoritative Google Sheets / Excel database backend
GOOGLE_APPS_SCRIPT_URL="https://script.google.com/macros/s/AKfycby0SeS3BBPkz_KY0a-ZqPcMmPftErSyJZbq4ABTJKSlNkR-PoRs9jAqM7j88KtyX_km/exec"
VITE_GOOGLE_APPS_SCRIPT_URL="https://script.google.com/macros/s/AKfycby0SeS3BBPkz_KY0a-ZqPcMmPftErSyJZbq4ABTJKSlNkR-PoRs9jAqM7j88KtyX_km/exec"

# GOOGLE_APPS_SCRIPT_API_KEY: Secret token shared between Axis Portal and Apps Script doPost
GOOGLE_APPS_SCRIPT_API_KEY=""
VITE_GOOGLE_APPS_SCRIPT_API_KEY=""
